dashboard MillingDashboard uses MillingMonitoringBinding {
  view "Spindle" {
    gauge Spindle.temperature min 20 max 90 severity 60, 75;
    gauge vibration min 0 max 12 severity 3, 4;
    history vibration, feedOverride over 1 h;
    tile speed;
    tile load;
    alarm Chatter;
  }
  view "Axes" {
    gauge rotaryTableTemperature min 20 max 90 severity 60, 70;
    tile position.x;
    tile position.y;
    tile position.z;
    tile position.a;
    tile position.c;
    alarm RotaryTableHeat;
  }
  view "Program and tool" {
    tile name;
    tile feedOverride;
    gauge remainingLife min 0 max 100;
    tile number;
    alarm WornTool;
    alarm SafeStop;
    button feedHold confirm "Activate the feed hold?";
    button abort confirm "Abort the NC program?";
    hide changeTo;
  }
  view "Coolant" {
    gauge pressure min 0 max 10;
    toggle boost;
    alarm CoolantLoss;
  }
}
