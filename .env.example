# Optional: copy to .env and set the API key of your provider for the LLM steps. Everything else has defaults.
# AI_PROVIDER is groq (default), mistral or nvidia (https://build.nvidia.com).
AI_PROVIDER=groq
MISTRAL_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
# Empty means the provider default: openai/gpt-oss-120b (Groq), ministral-14b-2512 (Mistral), nvidia/nemotron-3-ultra-550b-a55b (NVIDIA).
AI_MODEL=
AI_TIMEOUT_SECONDS=600
AI_MAX_OUTPUT_TOKENS=20000
